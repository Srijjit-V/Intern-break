# Copy to .env and edit. Never commit .env.

# --- Server ---
# HTTP port the Express server listens on.
PORT=3000
# Bind address (0.0.0.0 inside containers, 127.0.0.1 for local-only).
HOST=0.0.0.0

# --- Database (MySQL 8) ---
# Either one URL...
# DATABASE_URL=mysql://intern:change-me@localhost:3306/intern_break
# ...or the individual parts (used by docker compose too):
DB_HOST=localhost
DB_PORT=3306
DB_USER=intern
DB_PASS=change-me
DB_NAME=intern_break
# Set true to connect over TLS (managed databases). Certificate checks stay on
# unless DB_SSL_REJECT_UNAUTHORIZED=false.
DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=false
# Root password for the MySQL container in compose.yaml only.
DB_ROOT_PASS=change-me-too

# --- Auth (better-auth) ---
# Session signing secret, 32+ random chars. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# Public URL of the app (same origin the browser uses).
BETTER_AUTH_URL=http://localhost:3000
# Extra allowed origins, comma-separated. localhost is always allowed.
# BETTER_AUTH_TRUSTED_ORIGINS=https://app.example.com
# Only if the app is embedded in a third-party iframe (needs HTTPS).
# COOKIE_CROSS_SITE=false

# --- Seed (npm run db:seed) ---
# Password for the fake demo accounts. Local use only.
# SEED_PASSWORD=demo-password-123

# --- Client build flags ---
# Static demo build (no server, no login). Used by npm run build:pages.
# VITE_DEMO_MODE=true
# Base path when served from a sub-path, e.g. /Intern-break/ on GitHub Pages.
# VITE_BASE_PATH=/
